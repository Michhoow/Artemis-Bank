@model CreditCardIndexViewModel
@{ ViewData["Title"] = "Gestión de tarjetas de crédito"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Gestión de tarjetas de crédito</h1>
    <a class="btn btn-primary" asp-action="SelectClient">
        <i class="bi bi-plus-lg me-1"></i> Asignar tarjeta
    </a>
</div>

<form method="get" class="card card-body shadow-sm mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="identification">Cédula del cliente</label>
            <input id="identification" name="identification" class="form-control" data-cedula
                   value="@Model.Identification" placeholder="000-0000000-0" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="status">Estado</label>
            <select id="status" name="status" class="form-select">
                <option value="activa" selected="@(Model.Status == "activa")">Activas</option>
                <option value="cancelada" selected="@(Model.Status == "cancelada")">Canceladas</option>
                <option value="todas" selected="@(Model.Status == "todas")">Todas</option>
            </select>
        </div>
        <div class="col-md-3 d-grid">
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
        </div>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.InfoMessage))
{
    <div class="alert alert-info">@Model.InfoMessage</div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle bg-white">
        <thead class="table-light">
            <tr>
                <th>Número de tarjeta</th>
                <th>Cliente</th>
                <th class="text-end">Límite de crédito</th>
                <th class="text-end">Monto adeudado</th>
                <th class="text-end">Crédito disponible</th>
                <th>Expiración</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Cards.Data.Any())
        {
            <tr><td colspan="8" class="text-center text-secondary py-4">No hay tarjetas para mostrar.</td></tr>
        }
        else
        {
            @foreach (var card in Model.Cards.Data)
            {
                <tr>

                    <td class="font-monospace">@card.MaskedNumber</td>
                    <td>
                        @card.ClientFullName<br />
                        <span class="text-secondary small">@Cedula.Format(card.ClientIdentification)</span>
                    </td>
                    <td class="text-end">@card.CreditLimitDisplay</td>
                    <td class="text-end fw-semibold">@card.DebtDisplay</td>
                    <td class="text-end">@card.AvailableCreditDisplay</td>
                    <td>@card.ExpirationDate</td>
                    <td>
                        <span class="badge @(card.IsActive ? "bg-success" : "bg-secondary")">@card.Status</span>
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary"
                           asp-action="Details" asp-route-id="@card.Id">Ver detalles</a>
                        @if (card.IsActive)
                        {
                            <a class="btn btn-sm btn-outline-primary"
                               asp-action="Edit" asp-route-id="@card.Id">Editar límite</a>
                            @if (!card.HasDebt)
                            {
                                <a class="btn btn-sm btn-outline-danger"
                                   asp-action="Cancel" asp-route-id="@card.Id">Cancelar</a>
                            }
                        }
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

@{
    var pager = ArtemisBank.Core.Application.ViewModels.PagerViewModel.For(
        Model.Cards.Page, Model.Cards.TotalPages, "Index", "CreditCard",
        new Dictionary<string, string>
        {
            ["identification"] = Model.Identification ?? string.Empty,
            ["status"] = Model.Status
        });
}
<partial name="_Pager" model="pager" />
