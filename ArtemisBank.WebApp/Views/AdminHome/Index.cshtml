@model AdminHomeViewModel
@{ ViewData["Title"] = "Dashboard Administrador"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h4 mb-0">Overview del Sistema</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-controller="User" asp-action="Create">
            <i class="bi bi-person-plus me-1"></i> Nuevo Usuario
        </a>
    </div>
</div>

<div class="row g-4 mb-5">
    @{
        var indicators = new (string Label, string Value, string Icon, string ColorClass)[]
        {
            ("Transacciones Históricas", Model.TotalHistoricTransactions.ToString("N0"), "bi-clock-history", "text-primary"),
            ("Transacciones del Día", Model.TodayTransactions.ToString("N0"), "bi-lightning-charge", "text-warning"),
            ("Pagos Históricos", Model.TotalHistoricPayments.ToString("N0"), "bi-cash-stack", "text-success"),
            ("Pagos del Día", Model.TodayPayments.ToString("N0"), "bi-calendar-check", "text-info"),
            ("Clientes Activos", Model.ActiveClients.ToString("N0"), "bi-person-check", "text-primary"),
            ("Clientes Inactivos", Model.InactiveClients.ToString("N0"), "bi-person-dash", "text-danger"),
            ("Total Productos", Model.TotalFinancialProducts.ToString("N0"), "bi-box-seam", "text-secondary"),
            ("Préstamos Vigentes", Model.ActiveLoans.ToString("N0"), "bi-bank", "text-warning"),
            ("Tarjetas Activas", Model.ActiveCreditCards.ToString("N0"), "bi-credit-card", "text-info"),
            ("Cuentas Activas", Model.ActiveSavingsAccounts.ToString("N0"), "bi-wallet2", "text-success"),
            ("Promedio Deuda Cliente", "RD$" + Model.AverageDebtPerClient.ToString("N2"), "bi-graph-down-arrow", "text-danger")
        };
    }
    @foreach (var indicator in indicators)
    {
        <div class="col-6 col-md-4 col-lg-3 col-xl-2">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                            <i class="bi @indicator.Icon fs-5 @indicator.ColorClass"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold mb-1">@indicator.Value</h4>
                    <p class="text-muted small text-uppercase mb-0" style="font-size: 0.65rem; letter-spacing: 0.05em;">@indicator.Label</p>
                </div>
            </div>
        </div>
    }
</div>

<h5 class="mb-3 text-secondary">Acciones Rápidas</h5>
<div class="row g-3">
    <div class="col-md-6 col-xl-3">
        <a asp-controller="SavingsAccount" asp-action="Index" class="card h-100 text-decoration-none shadow-hover text-center p-4">
            <i class="bi bi-wallet2 fs-1 text-success mb-2"></i>
            <h6 class="text-dark fw-semibold mb-0">Cuentas de Ahorro</h6>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a asp-controller="User" asp-action="Index" class="card h-100 text-decoration-none shadow-hover text-center p-4">
            <i class="bi bi-people fs-1 text-primary mb-2"></i>
            <h6 class="text-dark fw-semibold mb-0">Gestión Usuarios</h6>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a asp-controller="Loan" asp-action="Index" class="card h-100 text-decoration-none shadow-hover text-center p-4">
            <i class="bi bi-cash-stack fs-1 text-warning mb-2"></i>
            <h6 class="text-dark fw-semibold mb-0">Gestión Préstamos</h6>
        </a>
    </div>
    <div class="col-md-6 col-xl-3">
        <a asp-controller="CreditCard" asp-action="Index" class="card h-100 text-decoration-none shadow-hover text-center p-4">
            <i class="bi bi-credit-card fs-1 text-info mb-2"></i>
            <h6 class="text-dark fw-semibold mb-0">Tarjetas Crédito</h6>
        </a>
    </div>
</div>
