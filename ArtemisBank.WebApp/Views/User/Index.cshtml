@model UserIndexViewModel
@{ ViewData["Title"] = "Gestión de usuarios"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Gestión de usuarios</h1>
    <a class="btn btn-primary" asp-action="Create">
        <i class="bi bi-plus-lg me-1"></i> Crear usuario
    </a>
</div>

<form method="get" class="card card-body shadow-sm mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-9">
            <label class="form-label" for="role">Rol</label>
            <select id="role" name="role" class="form-select">
                <option value="">Todos los roles</option>
                @foreach (var role in UserIndexViewModel.AvailableRoles)
                {
                    <option value="@role" selected="@(Model.Role == role)">@role</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-grid">
            <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        </div>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.InfoMessage))
{
    <div class="alert alert-info">@Model.InfoMessage</div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle bg-white">
        <thead class="table-light">
            <tr>
                <th>Nombre</th>
                <th>Usuario</th>
                <th>Cédula</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Users.Data.Any())
        {
            <tr><td colspan="7" class="text-center text-secondary py-4">No hay usuarios para mostrar.</td></tr>
        }
        else
        {
            @foreach (var user in Model.Users.Data)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.UserName</td>
                    <td class="font-monospace">@Cedula.Format(user.Identification)</td>
                    <td>@user.Email</td>
                    <td><span class="badge bg-primary">@user.Role</span></td>
                    <td>
                        <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">
                            @(user.IsActive ? "Activo" : "Inactivo")
                        </span>
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-action="Edit" asp-route-id="@user.Id">Editar</a>
                        <a class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                           asp-action="ChangeStatus" asp-route-id="@user.Id">
                            @(user.IsActive ? "Inactivar" : "Activar")
                        </a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

@{
    var pager = ArtemisBank.Core.Application.ViewModels.PagerViewModel.For(
        Model.Users.Page, Model.Users.TotalPages, "Index", "User",
        new Dictionary<string, string> { ["role"] = Model.Role ?? string.Empty });
}
<partial name="_Pager" model="pager" />
