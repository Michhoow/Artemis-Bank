@{
    var role = User.IsInRole(ArtemisRoles.Administrador) ? ArtemisRoles.Administrador
             : User.IsInRole(ArtemisRoles.Cajero) ? ArtemisRoles.Cajero
             : User.IsInRole(ArtemisRoles.Cliente) ? ArtemisRoles.Cliente
             : string.Empty;

    var ctrlActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    string Activo(string controlador, string? accion = null)
    {
        if (!string.Equals(ctrlActual, controlador, StringComparison.OrdinalIgnoreCase))
            return string.Empty;

        if (accion is not null &&
            !string.Equals(accionActual, accion, StringComparison.OrdinalIgnoreCase))
            return string.Empty;

        return " active";
    }
}

<aside class="sidebar">
    <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
        <i class="bi bi-bank"></i>
        <span>ArtemisBank</span>
    </a>

    <nav class="sidebar-nav mt-3">
        @if (role == ArtemisRoles.Administrador)
        {
            <div class="nav-section-title">Main Menu</div>
            <a class="nav-link@(Activo("AdminHome"))" asp-controller="AdminHome" asp-action="Index">
                <i class="bi bi-grid"></i> Dashboard
            </a>
            <a class="nav-link@(Activo("User"))" asp-controller="User" asp-action="Index">
                <i class="bi bi-people"></i> Usuarios
            </a>
            
            <div class="nav-section-title">Productos</div>
            <a class="nav-link@(Activo("Loan"))" asp-controller="Loan" asp-action="Index">
                <i class="bi bi-cash-stack"></i> Préstamos
            </a>
            <a class="nav-link@(Activo("CreditCard"))" asp-controller="CreditCard" asp-action="Index">
                <i class="bi bi-credit-card"></i> Tarjetas
            </a>
            <a class="nav-link@(Activo("SavingsAccount"))" asp-controller="SavingsAccount" asp-action="Index">
                <i class="bi bi-wallet2"></i> Cuentas
            </a>
        }
        else if (role == ArtemisRoles.Cajero)
        {
            <div class="nav-section-title">Main Menu</div>
            <a class="nav-link@(Activo("Cashier", "Index"))" asp-controller="Cashier" asp-action="Index">
                <i class="bi bi-grid"></i> Inicio
            </a>
            
            <div class="nav-section-title">Operaciones</div>
            <a class="nav-link@(Activo("Cashier", "Deposit"))" asp-controller="Cashier" asp-action="Deposit">
                <i class="bi bi-box-arrow-in-down"></i> Depósito
            </a>
            <a class="nav-link@(Activo("Cashier", "Withdrawal"))" asp-controller="Cashier" asp-action="Withdrawal">
                <i class="bi bi-box-arrow-up"></i> Retiro
            </a>
            
            <div class="nav-section-title">Pagos</div>
            <a class="nav-link@(Activo("Cashier", "CardPayment"))" asp-controller="Cashier" asp-action="CardPayment">
                <i class="bi bi-credit-card"></i> Pago Tarjeta
            </a>
            <a class="nav-link@(Activo("Cashier", "LoanPayment"))" asp-controller="Cashier" asp-action="LoanPayment">
                <i class="bi bi-cash-stack"></i> Pago Préstamo
            </a>
            <a class="nav-link@(Activo("Cashier", "ThirdParty"))" asp-controller="Cashier" asp-action="ThirdParty">
                <i class="bi bi-people"></i> Terceros
            </a>
        }
        else if (role == ArtemisRoles.Cliente)
        {
            <div class="nav-section-title">Main Menu</div>
            <a class="nav-link@(Activo("ClientHome"))" asp-controller="ClientHome" asp-action="Index">
                <i class="bi bi-grid"></i> Dashboard
            </a>
            
            <div class="nav-section-title">Transacciones</div>
            <a class="nav-link@(Activo("Transaction", "Express"))" asp-controller="Transaction" asp-action="Express">
                <i class="bi bi-lightning"></i> Express
            </a>
            <a class="nav-link@(Activo("Transfer"))" asp-controller="Transfer" asp-action="Index">
                <i class="bi bi-arrow-left-right"></i> Transferencias
            </a>
            
            <div class="nav-section-title">Otros</div>
            <a class="nav-link@(Activo("CashAdvance"))" asp-controller="CashAdvance" asp-action="Index">
                <i class="bi bi-cash"></i> Avance Efectivo
            </a>
            <a class="nav-link@(Activo("Beneficiary"))" asp-controller="Beneficiary" asp-action="Index">
                <i class="bi bi-person-lines-fill"></i> Beneficiarios
            </a>
        }
    </nav>
    
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <div class="p-3 mt-auto">
            <div class="card bg-light shadow-none border-0">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <img src="https://ui-avatars.com/api/?name=@User.Identity.Name&background=0D7C85&color=fff" class="rounded-circle" width="36" height="36" alt="Avatar" />
                    <div class="overflow-hidden">
                        <div class="fw-semibold text-truncate" style="font-size: 0.85rem;">@User.Identity.Name</div>
                        <div class="text-muted text-truncate" style="font-size: 0.75rem;">@role</div>
                    </div>
                </div>
            </div>
        </div>
    }
</aside>
