@model ClientHomeViewModel
@{ ViewData["Title"] = "Dashboard"; }

@if (!Model.HasAnyProduct)
{
    <div class="alert alert-info border-0 shadow-sm rounded-4">
        <i class="bi bi-info-circle me-2"></i> @AppMessages.NoActiveFinancialProducts
    </div>
}

<!-- Row 1: Cards and Balance Summary -->
<div class="row g-4 mb-4">
    <!-- Balance Summary Card -->
    <div class="col-xl-8">
        <div class="card h-100">
            <div class="card-body p-4 d-flex flex-column justify-content-center">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h6 class="text-muted text-uppercase mb-1" style="letter-spacing: 0.05em;">Total Balance</h6>
                        @{
                            decimal totalSavings = Model.HasSavingsAccounts ? Model.SavingsAccounts.Sum(a => a.Balance) : 0;
                        }
                        <h2 class="display-5 fw-bold mb-0 text-dark">RD$ @totalSavings.ToString("N2")</h2>
                    </div>
                    <span class="badge bg-success rounded-pill px-3 py-2">
                        <i class="bi bi-arrow-up-right"></i> Active
                    </span>
                </div>
                
                <div class="d-flex gap-4">
                    <a href="@Url.Action("Express", "Transaction")" class="text-decoration-none text-center">
                        <div class="btn-icon-rounded mb-2">
                            <i class="bi bi-send-fill"></i>
                        </div>
                        <div class="small fw-medium text-dark">Send</div>
                    </a>
                    <a href="@Url.Action("Index", "Transfer")" class="text-decoration-none text-center">
                        <div class="btn-icon-rounded mb-2">
                            <i class="bi bi-wallet-fill"></i>
                        </div>
                        <div class="small fw-medium text-dark">Transfer</div>
                    </a>
                    <a href="@Url.Action("Index", "Beneficiary")" class="text-decoration-none text-center">
                        <div class="btn-icon-rounded mb-2">
                            <i class="bi bi-three-dots"></i>
                        </div>
                        <div class="small fw-medium text-dark">More</div>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Virtual Credit Card (First available credit card or a placeholder) -->
    <div class="col-xl-4">
        @if (Model.HasCreditCards)
        {
            var card = Model.CreditCards.First();
            <div class="virtual-card h-100 d-flex flex-column justify-content-between">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="virtual-card-chip"></div>
                    <i class="bi bi-credit-card-2-front fs-2 opacity-50"></i>
                </div>
                <div class="virtual-card-number mt-4 mb-4">
                    @card.MaskedNumber
                </div>
                <div class="virtual-card-bottom">
                    <div>
                        <div class="virtual-card-label">Card Holder</div>
                        <div class="fw-semibold">@User.Identity?.Name</div>
                    </div>
                    <div class="text-end">
                        <div class="virtual-card-label">Expires</div>
                        <div class="fw-semibold">@card.ExpirationDate</div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card h-100 border border-2 border-dashed bg-light shadow-none">
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="bi bi-plus-circle text-muted fs-1 mb-2"></i>
                    <h6 class="fw-semibold text-muted">Add Debit Card</h6>
                </div>
            </div>
        }
    </div>
</div>

<!-- Row 2: Savings and Loans Data -->
<div class="row g-4 mb-4">
    <div class="col-xl-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Cuentas de Ahorro</h6>
                <button class="btn btn-sm btn-light rounded-circle"><i class="bi bi-three-dots"></i></button>
            </div>
            <div class="card-body p-0">
                @if (Model.HasSavingsAccounts)
                {
                    <div class="list-group list-group-flush">
                        @foreach (var account in Model.SavingsAccounts)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center p-3 border-bottom-0">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="bi bi-piggy-bank fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-dark">@account.Type</div>
                                        <div class="small text-muted font-monospace">@account.AccountNumber</div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-dark">RD$ @account.Balance.ToString("N2")</div>
                                    <a class="small text-decoration-none" asp-action="AccountDetails" asp-route-accountNumber="@account.AccountNumber">Ver detalles</a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">No hay cuentas de ahorro.</div>
                }
            </div>
        </div>
    </div>

    <!-- Loan Overview (Instead of Gauge Chart since we use existing data) -->
    <div class="col-xl-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Préstamos Activos</h6>
                <button class="btn btn-sm btn-light rounded-circle"><i class="bi bi-three-dots"></i></button>
            </div>
            <div class="card-body">
                @if (Model.HasLoans)
                {
                    @foreach (var loan in Model.Loans.Take(3))
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-cash-stack"></i>
                                </div>
                                <div>
                                    <div class="fw-medium text-dark">Préstamo @loan.LoanNumber</div>
                                    <div class="small text-muted">@loan.PaidInstallments / @loan.TotalInstallments cuotas</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-semibold text-expense">RD$ @loan.PendingAmount.ToString("N2")</div>
                                <span class="badge @(loan.Status == "En mora" ? "bg-danger" : "bg-success")" style="font-size: 0.65rem;">@loan.Status</span>
                            </div>
                        </div>
                    }
                    @if (Model.Loans.Count() > 3)
                    {
                        <div class="text-center mt-3">
                            <a href="#" class="text-decoration-none small">View all loans</a>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted h-100 d-flex align-items-center justify-content-center">
                        No hay préstamos activos.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Row 3: Credit Cards Table -->
@if (Model.HasCreditCards && Model.CreditCards.Count() > 1)
{
    <div class="card mb-4">
        <div class="card-header">
            <h6 class="mb-0">Otras Tarjetas de Crédito</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Número</th>
                        <th>Vencimiento</th>
                        <th class="text-end">Límite</th>
                        <th class="text-end">Deuda</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var card in Model.CreditCards.Skip(1))
                    {
                        <tr>
                            <td class="font-monospace"><i class="bi bi-credit-card text-primary me-2"></i>@card.MaskedNumber</td>
                            <td>@card.ExpirationDate</td>
                            <td class="text-end">RD$@card.CreditLimit.ToString("N2")</td>
                            <td class="text-end fw-semibold text-expense">RD$@card.Debt.ToString("N2")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                   asp-controller="CreditCard" asp-action="Details" asp-route-id="@card.Id">Detalles</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
