@model AccountTransactionsViewModel
@{ ViewData["Title"] = "Detalle de mi cuenta"; }

<h1 class="h4 mb-3">Transacciones de la cuenta @Model.AccountNumber</h1>

<div class="card card-body shadow-sm mb-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">Balance actual</dt><dd class="col-sm-3">RD$@Model.Balance.ToString("N2")</dd>
        <dt class="col-sm-3">Tipo de cuenta</dt><dd class="col-sm-3">@Model.Type</dd>
    </dl>
</div>

<partial name="_TransactionsTable" model="Model.Transactions" />

@{
    var pager = ArtemisBank.Core.Application.ViewModels.PagerViewModel.For(
        Model.Transactions.Page, Model.Transactions.TotalPages, "AccountDetails", "ClientHome",
        new Dictionary<string, string> { ["accountNumber"] = Model.AccountNumber });
}
<partial name="_Pager" model="pager" />

<a class="btn btn-outline-secondary mt-3" asp-action="Index">Volver atrás</a>
