@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_AuthLayout";
}

<h2>Recuperar contraseña</h2>
<p class="lead-sub">
    Escriba el correo de su cuenta y le enviaremos un enlace para crear
    una contraseña nueva.
</p>

<form method="post" asp-action="ForgotPassword">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small"></div>

    <div class="mb-4">
        <label class="form-label" asp-for="Email"></label>
        <div class="input-group">
            <span class="input-group-text bg-white text-secondary">
                <i class="bi bi-envelope"></i>
            </span>
            <input class="form-control border-start-0 ps-0" asp-for="Email"
                   type="email" autocomplete="email" autofocus placeholder="nombre@artemisbank.do" />
        </div>
        <span class="text-danger small" asp-validation-for="Email"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100 auth-submit">Enviar enlace</button>

    <div class="text-center mt-3 auth-links">
        <a asp-action="Index" class="text-decoration-none">Volver a iniciar sesión</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
