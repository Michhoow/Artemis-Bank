@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer contraseña";
    Layout = "_AuthLayout";
}

<h2>Nueva contraseña</h2>

@if (string.IsNullOrWhiteSpace(Model.UserId) || string.IsNullOrWhiteSpace(Model.Token))
{
    <p class="lead-sub">
        Este enlace ya no es válido. Solicite uno nuevo y úselo dentro de las
        próximas horas.
    </p>
    <a class="btn btn-primary w-100 auth-submit" asp-action="ForgotPassword">
        Solicitar otro enlace
    </a>
}
else
{
    <p class="lead-sub">Elija una contraseña de al menos 8 caracteres.</p>

    <form method="post" asp-action="ResetPassword">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small"></div>

        <div class="mb-3">
            <label class="form-label" asp-for="NewPassword"></label>
            <input class="form-control" asp-for="NewPassword" type="password"
                   autocomplete="new-password" autofocus />
            <span class="text-danger small" asp-validation-for="NewPassword"></span>
        </div>

        <div class="mb-4">
            <label class="form-label" asp-for="ConfirmPassword"></label>
            <input class="form-control" asp-for="ConfirmPassword" type="password"
                   autocomplete="new-password" />
            <span class="text-danger small" asp-validation-for="ConfirmPassword"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100 auth-submit">
            Guardar contraseña
        </button>

        <div class="text-center mt-3 auth-links">
            <a asp-action="Index" class="text-decoration-none">Cancelar</a>
        </div>
    </form>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
