@model WithdrawalViewModel
@{ ViewData["Title"] = "Retiro"; }

<h1 class="h4 mb-3">Retiro</h1>

<form method="post" asp-action="Withdrawal" class="card card-body shadow-sm mx-auto" style="max-width:640px">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label class="form-label" asp-for="SourceAccountNumber"></label>
        <input class="form-control" asp-for="SourceAccountNumber" maxlength="9" placeholder="123456789" />
        <span asp-validation-for="SourceAccountNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Amount"></label>
        <div class="input-group">
            <span class="input-group-text">RD$</span>
            <input class="form-control" asp-for="Amount" type="number" step="0.01" min="0.01" />
        </div>
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Realizar retiro</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

