@model ConfirmTransferViewModel
@{ ViewData["Title"] = "Confirmar transferencia"; }

<div class="card shadow-sm" style="max-width:640px">
    <div class="card-body">
        <h1 class="h5 mb-3">@AppMessages.ConfirmTransfer</h1>

        <dl class="row">
            <dt class="col-sm-5">Cuenta de origen</dt>
            <dd class="col-sm-7 font-monospace">@Model.SourceAccountNumber</dd>
            <dt class="col-sm-5">Cuenta de destino</dt>
            <dd class="col-sm-7 font-monospace">@Model.TargetAccountNumber</dd>
            <dt class="col-sm-5">Monto a transferir</dt>
            <dd class="col-sm-7 fw-semibold">RD$@Model.Amount.ToString("N2")</dd>
        </dl>

        <form method="post" asp-action="Confirm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="SourceAccountNumber" />
            <input type="hidden" asp-for="TargetAccountNumber" />
            <input type="hidden" asp-for="Amount" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Confirmar</button>
                <a class="btn btn-outline-secondary" asp-controller="ClientHome" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>
